# Add project specific ProGuard/R8 rules here.
# You can control the set of applied configuration files using the
# proguardFiles setting in build.gradle.kts.

# ---------------------------------------------------------------------------
# Official libxposed API 102 rules (from https://github.com/libxposed/api)
# ---------------------------------------------------------------------------
# Do not warn about annotation classes that are only present at compile time.
-dontwarn io.github.libxposed.annotation.**

# Rewrite the META-INF/xposed/java_init.list resource when R8 renames the entry
# class. This keeps the framework able to find the entry point after obfuscation.
-adaptresourcefilecontents META-INF/xposed/java_init.list

# Keep the public no-arg constructor of every XposedModule subclass so the
# framework can instantiate the entry class. allowoptimization and
# allowobfuscation let R8 still optimize and rename the class itself.
-keep,allowoptimization,allowobfuscation public class * extends io.github.libxposed.api.XposedModule {
    public <init>();
}

# ---------------------------------------------------------------------------
# kotlinx-serialization rules (for lsposed.orange.model.**)
# ---------------------------------------------------------------------------
# Keep the serializer classes generated by kotlinx-serialization so they remain
# reachable after R8 minification.
-keepattributes *Annotation*, InnerClasses
-keepclassmembers class kotlinx.serialization.json.** {
    *** Companion;
}
-keepclasseswithmembers class kotlinx.serialization.json.** {
    kotlinx.serialization.KSerializer serializer(...);
}
-keep,includedescriptorclasses class lsposed.orange.model.**$$serializer { *; }
-keepclassmembers class lsposed.orange.model.** {
    *** Companion;
}
-keepclasseswithmembers class lsposed.orange.model.** {
    kotlinx.serialization.KSerializer serializer(...);
}

# ---------------------------------------------------------------------------
# General settings
# ---------------------------------------------------------------------------
-keepattributes SourceFile,LineNumberTable
-renamesourcefileattribute SourceFile
